RewriteEngine On

# 1. Forza HTTPS e WWW in un unico passaggio (zero doppi redirect)
RewriteCond %{HTTP_HOST} !^www\. [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://www.ilviaggiodelprogrammatore.com/$1 [R=301,L]

# 2. Pulisci l'index.html dalla root (SEO friendly)
RewriteRule ^index\.html$ https://www.ilviaggiodelprogrammatore.com/ [R=301,L]

# ----------------------------------------------------------------------
# COMPRESSIONE GZIP/BROTLI (Lasciamo questa che funzionava bene)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# FORZATURA CACHE BROWSER (Aggressiva)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # 1. Smontiamo eventuali direttive di default del server
    Header unset Cache-Control
    Header unset Pragma

    # 2. Immagini e media: un anno, file immutabili (il browser non chiede mai se sono aggiornati)
    <FilesMatch "\.(ico|jpe?g|png|gif|svg|webp|woff2?|ttf|eot)$">
        Header always set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # 3. CSS e JS: un mese
    <FilesMatch "\.(css|js)$">
        Header always set Cache-Control "max-age=2592000, public"
    </FilesMatch>

    # 4. HTML: controllo frequente per fargli scaricare i nuovi articoli
    <FilesMatch "\.(html|htm)$">
        Header always set Cache-Control "max-age=3600, private, must-revalidate"
    </FilesMatch>
</IfModule>